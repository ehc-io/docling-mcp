# Docling MCP Server Configuration
MCP_PORT=3010
MCP_TRANSPORT=streamable-http
# MCP_TRANSPORT=sse  # Alternative: use SSE transport (deprecated)

# Tool Groups:
# - conversion, generation, manipulation: No external dependencies (default)
# - llama-index-rag: Requires Milvus server
# - llama-stack-rag, llama-stack-ie: Requires Llama Stack server

# Llama Index RAG settings (required for llama-index-rag tools)
# MILVUS_URI=http://milvus:19530
# OPENAI_API_KEY=your-key-here

# Llama Stack settings (required for llama-stack-rag/ie tools)
# LLAMA_STACK_BASE_URL=http://localhost:5000
